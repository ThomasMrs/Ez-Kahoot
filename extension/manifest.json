{
  "manifest_version": 3,
  "name": "Ez-Kahoot Companion",
  "version": "1.1.0",
  "description": "Relie la question visible à un corrigé chargé dans Ez-Kahoot. Créé par thomas marsa.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": {
    "default_title": "Ez-Kahoot Companion — thomas marsa",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Ouvrir Ez-Kahoot Companion"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
